# One-time key for creating the first owner account. Routine access uses named operator credentials.
OriginalRoot_OPERATOR_TOKEN=replace-with-a-long-random-secret

# Keep 0 for the loopback-only local Docker app. Set to 1 behind an HTTPS reverse proxy.
OriginalRoot_COOKIE_SECURE=0

# Optional: official daily mandi data from data.gov.in (kept server-side)
OriginalRoot_DATA_GOV_IN_API_KEY=

