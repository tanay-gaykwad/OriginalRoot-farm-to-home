# One-time key for creating the first workspace owner account.
ORIGINALROOT_OPERATOR_TOKEN=replace-with-a-long-random-secret

# Keep 0 for the loopback-only local Docker app. Set to 1 behind HTTPS.
ORIGINALROOT_COOKIE_SECURE=0

# Optional official mandi data source. The key stays on the server.
ORIGINALROOT_DATA_GOV_IN_API_KEY=
